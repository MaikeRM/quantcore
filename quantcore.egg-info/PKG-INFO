### 3. Exemplo de Uso Completo

```python
# examples/comprehensive_usage.py
"""
Exemplo completo de uso da biblioteca quantcore.
"""
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from typing import Dict, List

# Importações principais
from quantcore import quantcore
from quantcore.core.time import Date, Calendar
from quantcore.instruments.derivatives.options import EuropeanOption, OptionType
from quantcore.pricing.engines import PricingEngineFactory, EngineType
from quantcore.market.data import YahooFinanceSource
from quantcore.market.curves.yield import YieldCurveBuilder
from quantcore.risk.metrics import ValueAtRisk
from quantcore.portfolio.construction import MeanVarianceOptimizer

def example_1_option_pricing():
    """Exemplo 1: Precificação de opções com múltiplos métodos."""
    print("=== Exemplo 1: Precificação de Opções ===")
    
    # Criar opção europeia
    option = EuropeanOption(
        underlying_price=100.0,
        strike_price=105.0,
        time_to_maturity=0.5,  # 6 meses
        risk_free_rate=0.03,
        volatility=0.25,
        dividend_yield=0.01,
        option_type=OptionType.CALL
    )
    
    # Usar factory para criar engines
    factory = PricingEngineFactory()
    
    # 1. Precificação analítica (Black-Scholes)
    analytic_engine = factory.create_engine(option, EngineType.ANALYTIC)
    analytic_price = analytic_engine.calculate(option)
    print(f"Preço Analítico: {analytic_price:.4f}")
    
    # 2. Precificação por Monte Carlo
    mc_engine = factory.create_engine(
        option,
        EngineType.MONTE_CARLO,
        n_paths=100000,
        n_steps=252
    )
    mc_price = mc_engine.calculate(option)
    print(f"Preço Monte Carlo: {mc_price:.4f}")
    
    # 3. Precificação por árvore binomial
    binomial_engine = factory.create_engine(
        option,
        EngineType.BINOMIAL,
        steps=100
    )
    binomial_price = binomial_engine.calculate(option)
    print(f"Preço Binomial: {binomial_price:.4f}")
    
    # 4. Benchmark de todos os métodos
    benchmark_results = factory.benchmark_engines(
        option,
        params={'n_paths': 50000, 'steps': 100}
    )
    
    print("\nBenchmark dos Engines:")
    for method, results in benchmark_results.items():
        if results['success']:
            print(f"  {method}: {results['price']:.4f} ({results['time_seconds']:.3f}s)")
    
    return option, benchmark_results

def example_2_yield_curve_construction():
    """Exemplo 2: Construção de curva de juros."""
    print("\n=== Exemplo 2: Curva de Juros ===")
    
    # Dados de mercado
    market_instruments = [
        ('deposit', 0.25, 0.015),   # 3 meses
        ('deposit', 0.5, 0.016),    # 6 meses
        ('swap', 1.0, 0.018),       # 1 ano
        ('swap', 2.0, 0.020),       # 2 anos
        ('swap', 5.0, 0.025),       # 5 anos
        ('swap', 10.0, 0.030),      # 10 anos
    ]
    
    # Bootstrapping da curva
    builder = YieldCurveBuilder()
    curve = builder.bootstrap(market_instruments)
    
    # Interpolação em vários pontos
    times = np.linspace(0, 10, 50)
    zero_rates = [curve.zero_rate(t) for t in times]
    forward_rates = [curve.forward_rate(t, t+0.25) for t in times[:-1]]
    
    # Plot
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))
    
    ax1.plot(times, zero_rates, 'b-', linewidth=2)
    ax1.set_xlabel('Tempo (anos)')
    ax1.set_ylabel('Taxa Zero (%)')
    ax1.set_title('Curva Zero')
    ax1.grid(True)
    
    ax2.plot(times[:-1], forward_rates, 'r-', linewidth=2)
    ax2.set_xlabel('Tempo (anos)')
    ax2.set_ylabel('Taxa Forward 3M (%)')
    ax2.set_title('Curva Forward')
    ax2.grid(True)
    
    plt.tight_layout()
    plt.show()
    
    print(f"Taxa zero 1 ano: {curve.zero_rate(1.0):.3%}")
    print(f"Taxa forward 1y1y: {curve.forward_rate(1.0, 2.0):.3%}")
    
    return curve

def example_3_risk_metrics():
    """Exemplo 3: Métricas de risco."""
    print("\n=== Exemplo 3: Métricas de Risco ===")
    
    # Gerar retornos simulados
    np.random.seed(42)
    n_days = 1000
    returns = np.random.StudentT(df=5, loc=0.0005, scale=0.02, size=n_days)
    
    # Calcular VaR histórico
    var_calculator = ValueAtRisk(confidence_level=0.95, horizon=1)
    historical_var = var_calculator.historical(returns)
    
    # Calcular VaR paramétrico (distribuição t)
    from quantcore.core.math.statistics.distributions import StudentTDistribution
    
    # Ajustar distribuição t aos dados
    t_dist = StudentTDistribution.fit(returns)
    parametric_var = t_dist.var(alpha=0.05)
    
    # Calcular Expected Shortfall
    es = t_dist.cvar(alpha=0.05)
    
    print(f"Retorno médio: {np.mean(returns):.4%}")
    print(f"Volatilidade: {np.std(returns):.4%}")
    print(f"VaR Histórico 95%: {historical_var:.4%}")
    print(f"VaR Paramétrico 95%: {parametric_var:.4%}")
    print(f"Expected Shortfall 95%: {es:.4%}")
    print(f"Skewness: {t_dist.skewness:.4f}")
    print(f"Excess Kurtosis: {t_dist.kurtosis:.4f}")
    
    # Plot distribuição
    x = np.linspace(-0.1, 0.1, 1000)
    pdf = t_dist.pdf(x)
    
    plt.figure(figsize=(10, 6))
    plt.hist(returns, bins=50, density=True, alpha=0.5, label='Histograma')
    plt.plot(x, pdf, 'r-', linewidth=2, label=f't-dist (ν={t_dist.df:.1f})')
    plt.axvline(parametric_var, color='k', linestyle='--', label=f'VaR 95%')
    plt.axvline(es, color='g', linestyle='--', label=f'ES 95%')
    plt.xlabel('Retorno')
    plt.ylabel('Densidade')
    plt.title('Distribuição de Retornos e Medidas de Risco')
    plt.legend()
    plt.grid(True)
    plt.show()
    
    return returns, historical_var, parametric_var, es

def example_4_portfolio_optimization():
    """Exemplo 4: Otimização de portfólio."""
    print("\n=== Exemplo 4: Otimização de Portfólio ===")
    
    # Dados históricos de 4 ativos
    np.random.seed(42)
    n_assets = 4
    n_periods = 1000
    
    # Gerar retornos correlacionados
    means = np.array([0.0005, 0.0006, 0.0004, 0.0007])
    volatilities = np.array([0.02, 0.025, 0.018, 0.03])
    
    # Matriz de correlação
    corr_matrix = np.array([
        [1.00, 0.60, 0.40, 0.30],
        [0.60, 1.00, 0.50, 0.40],
        [0.40, 0.50, 1.00, 0.20],
        [0.30, 0.40, 0.20, 1.00]
    ])
    
    # Matriz de covariância
    cov_matrix = np.outer(volatilities, volatilities) * corr_matrix
    
    # Gerar retornos multivariados normais
    returns = np.random.multivariate_normal(means, cov_matrix, n_periods)
    
    # Otimização Mean-Variance
    optimizer = MeanVarianceOptimizer()
    
    # 1. Fronteira eficiente
    target_returns = np.linspace(0.0003, 0.0010, 20)
    efficient_portfolios = []
    
    for target_return in target_returns:
        try:
            weights = optimizer.optimize(
                expected_returns=means,
                covariance_matrix=cov_matrix,
                target_return=target_return
            )
            portfolio_return = weights @ means
            portfolio_vol = np.sqrt(weights @ cov_matrix @ weights)
            efficient_portfolios.append((portfolio_return, portfolio_vol, weights))
        except:
            continue
    
    # 2. Portfólio de mínima variância
    min_var_weights = optimizer.minimum_variance(
        expected_returns=means,
        covariance_matrix=cov_matrix
    )
    min_var_return = min_var_weights @ means
    min_var_vol = np.sqrt(min_var_weights @ cov_matrix @ min_var_weights)
    
    # 3. Portfólio de máximo Sharpe
    max_sharpe_weights = optimizer.maximum_sharpe(
        expected_returns=means,
        covariance_matrix=cov_matrix,
        risk_free_rate=0.03/252  # Taxa diária
    )
    max_sharpe_return = max_sharpe_weights @ means
    max_sharpe_vol = np.sqrt(max_sharpe_weights @ cov_matrix @ max_sharpe_weights)
    
    # Plot fronteira eficiente
    returns_array = np.array([p[0] for p in efficient_portfolios])
    vols_array = np.array([p[1] for p in efficient_portfolios])
    
    plt.figure(figsize=(10, 6))
    plt.plot(vols_array, returns_array, 'b-', linewidth=2, label='Fronteira Eficiente')
    plt.scatter(min_var_vol, min_var_return, color='red', s=100, 
                label='Mínima Variância', zorder=5)
    plt.scatter(max_sharpe_vol, max_sharpe_return, color='green', s=100,
                label='Máximo Sharpe', zorder=5)
    
    # Ativos individuais
    for i in range(n_assets):
        plt.scatter(volatilities[i], means[i], color='black', s=50)
        plt.annotate(f'Ativo {i+1}', (volatilities[i], means[i]),
                    xytext=(5, 5), textcoords='offset points')
    
    plt.xlabel('Volatilidade (diária)')
    plt.ylabel('Retorno Esperado (diário)')
    plt.title('Fronteira Eficiente de Markowitz')
    plt.legend()
    plt.grid(True)
    plt.show()
    
    print(f"Portfólio Mínima Variância:")
    print(f"  Retorno: {min_var_return*252:.2%} anual")
    print(f"  Volatilidade: {min_var_vol*np.sqrt(252):.2%} anual")
    print(f"  Pesos: {min_var_weights}")
    
    print(f"\nPortfólio Máximo Sharpe:")
    print(f"  Retorno: {max_sharpe_return*252:.2%} anual")
    print(f"  Volatilidade: {max_sharpe_vol*np.sqrt(252):.2%} anual")
    print(f"  Sharpe: {(max_sharpe_return - 0.03/252)/(max_sharpe_vol):.4f} diário")
    print(f"  Pesos: {max_sharpe_weights}")
    
    return efficient_portfolios, min_var_weights, max_sharpe_weights

def example_5_advanced_pricing():
    """Exemplo 5: Precificação avançada com modelos estocásticos."""
    print("\n=== Exemplo 5: Modelos Estocásticos Avançados ===")
    
    from quantcore.pricing.models.equity import HestonModel
    from quantcore.pricing.calibration import ModelCalibrator
    
    # Criar modelo Heston
    heston = HestonModel(
        v0=0.04,      # Variance inicial
        theta=0.04,   # Long-term variance
        kappa=2.0,    # Mean reversion speed
        sigma=0.3,    # Vol of vol
        rho=-0.7      # Correlation
    )
    
    # Dados de mercado (superfície de volatilidade)
    # Em um caso real, isso viria de dados de mercado
    strikes = np.linspace(80, 120, 9)
    maturities = np.array([0.25, 0.5, 1.0, 2.0])
    
    # Gerar superfície de volatilidade sintética
    market_vols = np.zeros((len(maturities), len(strikes)))
    for i, T in enumerate(maturities):
        for j, K in enumerate(strikes):
            # Volatilidade sintética com smile
            atm_vol = 0.25
            smile = 0.05 * (K/100 - 1)**2
            term_structure = 0.02 * np.sqrt(T)
            market_vols[i, j] = atm_vol + smile + term_structure
    
    # Calibrar modelo Heston
    calibrator = ModelCalibrator()
    
    calibration_result = calibrator.calibrate(
        model=heston,
        market_data=market_vols,
        strikes=strikes,
        maturities=maturities,
        underlying_price=100.0,
        risk_free_rate=0.03
    )
    
    if calibration_result.success:
        print("Calibração bem-sucedida!")
        print(f"Parâmetros calibrados: {calibration_result.parameters}")
        print(f"Erro RMSE: {calibration_result.calculate_errors()['root_mean_squared_error']:.6f}")
        
        # Plot superfície ajustada vs mercado
        fig = plt.figure(figsize=(12, 5))
        
        # Superfície de mercado
        ax1 = fig.add_subplot(121, projection='3d')
        X, Y = np.meshgrid(strikes, maturities)
        ax1.plot_surface(X, Y, market_vols, cmap='viridis', alpha=0.8)
        ax1.set_title('Superfície de Mercado')
        ax1.set_xlabel('Strike')
        ax1.set_ylabel('Maturity')
        ax1.set_zlabel('Volatilidade')
        
        # Superfície do modelo
        ax2 = fig.add_subplot(122, projection='3d')
        model_vols = calibration_result.model_prices.reshape(len(maturities), len(strikes))
        ax2.plot_surface(X, Y, model_vols, cmap='plasma', alpha=0.8)
        ax2.set_title('Superfície do Modelo Heston')
        ax2.set_xlabel('Strike')
        ax2.set_ylabel('Maturity')
        ax2.set_zlabel('Volatilidade')
        
        plt.tight_layout()
        plt.show()
    
    return heston, calibration_result

def main():
    """Função principal executando todos os exemplos."""
    print("quantcore - Biblioteca Quantitativa em Python")
    print("=" * 50)
    
    # Executar exemplos
    results = {}
    
    results['option_pricing'] = example_1_option_pricing()
    results['yield_curve'] = example_2_yield_curve_construction()
    results['risk_metrics'] = example_3_risk_metrics()
    results['portfolio_opt'] = example_4_portfolio_optimization()
    results['advanced_pricing'] = example_5_advanced_pricing()
    
    print("\n" + "=" * 50)
    print("Todos os exemplos executados com sucesso!")
    
    return results

if __name__ == "__main__":
    results = main()
