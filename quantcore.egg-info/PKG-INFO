## EXEMPLOS DE IMPLEMENTAÇÃO DETALHADA

### 1. Core Math - Distribuições com propriedades financeiras

```python
# quantcore/core/math/statistics/distributions/student_t.py
from typing import Tuple, Optional
import numpy as np
from scipy import special
from ...base import ContinuousDistribution
from ....utils.decorators import validate_input

class StudentTDistribution(ContinuousDistribution):
    """
    Student's t-distribution com ajustes para finanças.
    
    Parameters
    ----------
    df : float
        Degrees of freedom (ν > 0)
    loc : float
        Location parameter
    scale : float
        Scale parameter (σ > 0)
    
    Notes
    -----
    PDF: f(x) = Γ((ν+1)/2) / [√(νπ) Γ(ν/2)] * (1 + (x-μ)²/νσ²)^{-(ν+1)/2}
    
    Para finanças, ν tipicamente entre 3 e 10 para caudas mais pesadas.
    """
    
    def __init__(self, df: float, loc: float = 0.0, scale: float = 1.0):
        self.df = df
        self.loc = loc
        self.scale = scale
        self._validate_params()
        
    def _validate_params(self):
        if self.df <= 0:
            raise ValueError("Degrees of freedom must be positive")
        if self.scale <= 0:
            raise ValueError("Scale must be positive")
    
    @validate_input
    def pdf(self, x: np.ndarray) -> np.ndarray:
        """Probability density function."""
        z = (x - self.loc) / self.scale
        numerator = special.gamma((self.df + 1) / 2)
        denominator = (np.sqrt(self.df * np.pi) * special.gamma(self.df / 2) * 
                      self.scale)
        factor = numerator / denominator
        return factor * (1 + z**2 / self.df) ** (-(self.df + 1) / 2)
    
    @validate_input
    def cdf(self, x: np.ndarray) -> np.ndarray:
        """Cumulative distribution function."""
        z = (x - self.loc) / self.scale
        return special.stdtr(self.df, z)
    
    def ppf(self, q: np.ndarray) -> np.ndarray:
        """Percent point function (inverse CDF)."""
        return self.loc + self.scale * special.stdtrit(self.df, q)
    
    def moment(self, n: int) -> float:
        """n-th moment of the distribution."""
        if n % 2 == 1:  # Odd moments are 0 for symmetric t-dist
            return 0.0
        if n >= self.df:
            return np.inf
        # Formula for even moments
        k = n // 2
        moment = 1.0
        for i in range(k):
            moment *= (self.df - 2 * (i + 1))
        return (self.scale ** n) * moment
    
    @property
    def skewness(self) -> float:
        """Skewness (0 for symmetric t-distribution)."""
        return 0.0
    
    @property
    def kurtosis(self) -> float:
        """Excess kurtosis."""
        if self.df > 4:
            return 6 / (self.df - 4)
        elif self.df > 2:
            return np.inf
        else:
            return np.nan
    
    def fit(self, data: np.ndarray, method: str = 'mle') -> 'StudentTDistribution':
        """
        Fit distribution to data.
        
        Parameters
        ----------
        data : np.ndarray
            Sample data
        method : {'mle', 'moment'}
            Estimation method
            
        Returns
        -------
        StudentTDistribution
            Fitted distribution
        """
        if method == 'mle':
            # Implement MLE estimation
            from scipy import optimize
            
            def neg_log_likelihood(params):
                df, loc, scale = params
                if df <= 0 or scale <= 0:
                    return np.inf
                dist = StudentTDistribution(df, loc, scale)
                return -np.sum(np.log(dist.pdf(data) + 1e-10))
            
            # Initial guess
            init_df = 5.0
            init_loc = np.median(data)
            init_scale = np.std(data, ddof=1)
            
            result = optimize.minimize(
                neg_log_likelihood,
                [init_df, init_loc, init_scale],
                bounds=[(2.1, 100), (None, None), (1e-10, None)]
            )
            
            df, loc, scale = result.x
            return StudentTDistribution(df, loc, scale)
        
        elif method == 'moment':
            # Method of moments estimation
            mu = np.mean(data)
            sigma2 = np.var(data, ddof=1)
            excess_kurtosis = special.kurtosis(data, bias=False)
            
            if excess_kurtosis <= 0:
                df = np.inf  # Normal distribution
            else:
                df = 6 / excess_kurtosis + 4
            
            scale = np.sqrt(sigma2 * (df - 2) / df)
            return StudentTDistribution(df, mu, scale)
        
        else:
            raise ValueError(f"Unknown method: {method}")
    
    def var(self, alpha: float = 0.05) -> float:
        """Value at Risk for given confidence level."""
        return self.ppf(alpha)
    
    def cvar(self, alpha: float = 0.05) -> float:
        """Conditional Value at Risk (Expected Shortfall)."""
        # Analytical formula for t-distribution
        from scipy import special
        
        t_alpha = self.ppf(alpha)
        c = (self.df + t_alpha**2) / (self.df - 1)
        factor = special.gamma((self.df + 1) / 2) / (np.sqrt(np.pi * self.df) * 
                                                    special.gamma(self.df / 2))
        density = factor * (1 + t_alpha**2 / self.df) ** (-(self.df + 1) / 2)
        
        return self.loc - (self.scale * c * density / alpha)
```

### 2. Pricing Engine Factory Pattern

```python
# quantcore/pricing/engines/engine_factory.py
from typing import Dict, Type, Optional, Any
from enum import Enum
import inspect
from ...instruments.base import FinancialInstrument
from .base.pricing_engine import PricingEngine
from .analytic.black_scholes import BlackScholesEngine
from .lattice.binomial.cox_ross_rubinstein import CRREngine
from .monte_carlo.mc_pricer import MonteCarloEngine
from .finite_difference.fd_pricer import FiniteDifferenceEngine
from ....core.utils.exceptions import EngineNotFoundError

class EngineType(Enum):
    """Types of pricing engines available."""
    ANALYTIC = "analytic"
    BINOMIAL = "binomial"
    MONTE_CARLO = "monte_carlo"
    FINITE_DIFFERENCE = "finite_difference"
    FOURIER = "fourier"
    HYBRID = "hybrid"

class PricingEngineFactory:
    """
    Factory for creating appropriate pricing engines.
    
    Implements Registry pattern for dynamic engine registration.
    
    Examples
    --------
    >>> factory = PricingEngineFactory()
    >>> option = EuropeanOption(...)
    >>> 
    >>> # Get default engine for instrument
    >>> engine = factory.create_engine(option)
    >>> 
    >>> # Get specific engine type
    >>> mc_engine = factory.create_engine(
    ...     instrument=option,
    ...     engine_type=EngineType.MONTE_CARLO,
    ...     params={"n_paths": 100000}
    ... )
    """
    
    # Registry of available engines
    _engine_registry: Dict[str, Type[PricingEngine]] = {}
    _default_engines: Dict[str, EngineType] = {}
    
    def __init__(self):
        self._register_default_engines()
    
    @classmethod
    def register_engine(cls, 
                       instrument_class: Type[FinancialInstrument],
                       engine_type: EngineType,
                       engine_class: Type[PricingEngine]):
        """
        Register a new engine for an instrument class.
        
        Parameters
        ----------
        instrument_class : Type[FinancialInstrument]
            Class of instrument the engine can price
        engine_type : EngineType
            Type of engine
        engine_class : Type[PricingEngine]
            Engine class to register
        """
        key = f"{instrument_class.__name__}_{engine_type.value}"
        cls._engine_registry[key] = engine_class
    
    @classmethod
    def set_default_engine(cls,
                          instrument_class: Type[FinancialInstrument],
                          engine_type: EngineType):
        """
        Set default engine for an instrument class.
        
        Parameters
        ----------
        instrument_class : Type[FinancialInstrument]
            Instrument class
        engine_type : EngineType
            Default engine type
        """
        cls._default_engines[instrument_class.__name__] = engine_type
    
    def _register_default_engines(self):
        """Register all default engines."""
        from ...instruments.derivatives.options.european import EuropeanOption
        from ...instruments.derivatives.options.american import AmericanOption
        from ...instruments.derivatives.options.asian import AsianOption
        from ...instruments.fixed_income.bonds.fixed_rate import FixedRateBond
        
        # European Option engines
        self.register_engine(EuropeanOption, EngineType.ANALYTIC, BlackScholesEngine)
        self.register_engine(EuropeanOption, EngineType.BINOMIAL, CRREngine)
        self.register_engine(EuropeanOption, EngineType.MONTE_CARLO, MonteCarloEngine)
        self.register_engine(EuropeanOption, EngineType.FINITE_DIFFERENCE, FiniteDifferenceEngine)
        
        # American Option engines
        self.register_engine(AmericanOption, EngineType.BINOMIAL, CRREngine)
        self.register_engine(AmericanOption, EngineType.FINITE_DIFFERENCE, FiniteDifferenceEngine)
        
        # Asian Option engines
        self.register_engine(AsianOption, EngineType.MONTE_CARLO, MonteCarloEngine)
        
        # Fixed Rate Bond engines
        from .analytic.vasicek_bond import VasicekBondEngine
        self.register_engine(FixedRateBond, EngineType.ANALYTIC, VasicekBondEngine)
        
        # Set default engines
        self.set_default_engine(EuropeanOption, EngineType.ANALYTIC)
        self.set_default_engine(AmericanOption, EngineType.BINOMIAL)
        self.set_default_engine(AsianOption, EngineType.MONTE_CARLO)
        self.set_default_engine(FixedRateBond, EngineType.ANALYTIC)
    
    def create_engine(self,
                     instrument: FinancialInstrument,
                     engine_type: Optional[EngineType] = None,
                     **engine_params) -> PricingEngine:
        """
        Create appropriate pricing engine for instrument.
        
        Parameters
        ----------
        instrument : FinancialInstrument
            Instrument to price
        engine_type : EngineType, optional
            Specific engine type, if None uses default
        **engine_params : dict
            Parameters to pass to engine constructor
            
        Returns
        -------
        PricingEngine
            Configured pricing engine
            
        Raises
        ------
        EngineNotFoundError
            If no suitable engine found
        """
        # Determine engine type
        if engine_type is None:
            engine_type = self._get_default_engine_type(instrument)
        
        # Find engine class
        instrument_class = type(instrument).__name__
        key = f"{instrument_class}_{engine_type.value}"
        
        if key not in self._engine_registry:
            raise EngineNotFoundError(
                f"No engine found for {instrument_class} with type {engine_type}"
            )
        
        engine_class = self._engine_registry[key]
        
        # Check if engine can handle the instrument
        if not self._engine_supports_instrument(engine_class, instrument):
            raise EngineNotFoundError(
                f"Engine {engine_class.__name__} does not support {instrument_class}"
            )
        
        # Create engine instance
        return engine_class(**engine_params)
    
    def _get_default_engine_type(self, instrument: FinancialInstrument) -> EngineType:
        """Get default engine type for instrument."""
        instrument_class = type(instrument).__name__
        
        if instrument_class in self._default_engines:
            return self._default_engines[instrument_class]
        
        # Fallback: try to find any registered engine
        for engine_type in EngineType:
            key = f"{instrument_class}_{engine_type.value}"
            if key in self._engine_registry:
                return engine_type
        
        raise EngineNotFoundError(f"No engine found for {instrument_class}")
    
    def _engine_supports_instrument(self, 
                                   engine_class: Type[PricingEngine],
                                   instrument: FinancialInstrument) -> bool:
        """Check if engine can price the instrument."""
        # Check engine's can_price method if it exists
        if hasattr(engine_class, 'can_price'):
            return engine_class.can_price(instrument)
        
        # Otherwise check constructor signature
        sig = inspect.signature(engine_class.__init__)
        params = list(sig.parameters.keys())
        
        # Engine should accept at least the instrument
        return len(params) >= 2  # self + instrument
    
    def get_available_engines(self, 
                             instrument: FinancialInstrument) -> Dict[EngineType, Type[PricingEngine]]:
        """
        Get all available engines for an instrument.
        
        Parameters
        ----------
        instrument : FinancialInstrument
            Instrument to check
            
        Returns
        -------
        Dict[EngineType, Type[PricingEngine]]
            Available engines
        """
        instrument_class = type(instrument).__name__
        available = {}
        
        for engine_type in EngineType:
            key = f"{instrument_class}_{engine_type.value}"
            if key in self._engine_registry:
                engine_class = self._engine_registry[key]
                if self._engine_supports_instrument(engine_class, instrument):
                    available[engine_type] = engine_class
        
        return available
    
    def benchmark_engines(self,
                         instrument: FinancialInstrument,
                         engines: Optional[list[EngineType]] = None,
                         **benchmark_params) -> Dict[str, Any]:
        """
        Benchmark different engines for an instrument.
        
        Parameters
        ----------
        instrument : FinancialInstrument
            Instrument to benchmark
        engines : list[EngineType], optional
            Engines to benchmark, if None uses all available
        **benchmark_params : dict
            Benchmark parameters
            
        Returns
        -------
        Dict[str, Any]
            Benchmark results
        """
        import time
        from ....utils.performance import Timer
        
        if engines is None:
            engines_dict = self.get_available_engines(instrument)
            engines = list(engines_dict.keys())
        
        results = {}
        
        for engine_type in engines:
            try:
                # Create engine
                engine = self.create_engine(instrument, engine_type, **benchmark_params)
                
                # Time the pricing
                timer = Timer()
                with timer:
                    price = engine.calculate(instrument)
                
                # Get additional metrics
                results[engine_type.value] = {
                    'price': price,
                    'time_seconds': timer.elapsed,
                    'engine_class': type(engine).__name__,
                    'success': True
                }
                
            except Exception as e:
                results[engine_type.value] = {
                    'price': None,
                    'time_seconds': None,
                    'error': str(e),
                    'success': False
                }
        
        return results
```

### 3. Sistema de Calibração com múltiplos métodos

```python
# quantcore/pricing/calibration/calibration_system.py
from typing import Dict, List, Tuple, Optional, Callable, Any
import numpy as np
from dataclasses import dataclass
from enum import Enum
from scipy import optimize
from ...models.base import StochasticModel
from ....market.data.models import MarketData
from ....core.math.optimization import OptimizationResult
from .optimizers import OptimizerType, create_optimizer
from .objectives import ObjectiveFunction, create_objective
from .constraints import ConstraintSet, create_constraints

class CalibrationMethod(Enum):
    """Calibration methods available."""
    LEAST_SQUARES = "least_squares"
    MAXIMUM_LIKELIHOOD = "maximum_likelihood"
    BAYESIAN = "bayesian"
    MACHINE_LEARNING = "machine_learning"

@dataclass
class CalibrationResult:
    """Results of model calibration."""
    success: bool
    parameters: Dict[str, float]
    initial_guess: Dict[str, float]
    objective_value: float
    iterations: int
    convergence_message: str
    calibration_time: float
    residuals: Optional[np.ndarray] = None
    jacobian: Optional[np.ndarray] = None
    hessian: Optional[np.ndarray] = None
    confidence_intervals: Optional[Dict[str, Tuple[float, float]]] = None
    market_data: Optional[MarketData] = None
    model_prices: Optional[np.ndarray] = None
    market_prices: Optional[np.ndarray] = None
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary for serialization."""
        return {
            'success': self.success,
            'parameters': self.parameters,
            'objective_value': self.objective_value,
            'iterations': self.iterations,
            'calibration_time': self.calibration_time,
            'confidence_intervals': self.confidence_intervals
        }
    
    def calculate_errors(self) -> Dict[str, float]:
        """Calculate various error metrics."""
        if self.model_prices is None or self.market_prices is None:
            return {}
        
        errors = self.model_prices - self.market_prices
        abs_errors = np.abs(errors)
        rel_errors = abs_errors / np.abs(self.market_prices)
        
        return {
            'mean_absolute_error': np.mean(abs_errors),
            'root_mean_squared_error': np.sqrt(np.mean(errors**2)),
            'max_absolute_error': np.max(abs_errors),
            'mean_relative_error': np.mean(rel_errors),
            'r_squared': 1 - np.sum(errors**2) / np.sum((self.market_prices - np.mean(self.market_prices))**2)
        }

class ModelCalibrator:
    """
    Sistema de calibração unificado para modelos estocásticos.
    
    Suporta múltiplos métodos de otimização, funções objetivo e restrições.
    
    Examples
    --------
    >>> calibrator = ModelCalibrator()
    >>> model = HestonModel()
    >>> market_data = load_volatility_surface()
    >>> 
    >>> # Calibração básica
    >>> result = calibrator.calibrate(
    ...     model=model,
    ...     market_data=market_data,
    ...     method=CalibrationMethod.LEAST_SQUARES
    ... )
    >>> 
    >>> # Calibração com restrições
    >>> result = calibrator.calibrate(
    ...     model=model,
    ...     market_data=market_data,
    ...     constraints={'v0': (0.01, 0.5), 'theta': (0.01, 1.0)}
    ... )
    """
    
    def __init__(self):
        self._optimizers = self._initialize_optimizers()
        self._objectives = self._initialize_objectives()
        self._constraints = self._initialize_constraints()
    
    def _initialize_optimizers(self) -> Dict[OptimizerType, Callable]:
        """Initialize available optimizers."""
        return {
            OptimizerType.LEVENBERG_MARQUARDT: optimize.least_squares,
            OptimizerType.NELDER_MEAD: optimize.minimize,
            OptimizerType.BFGS: optimize.minimize,
            OptimizerType.L_BFGS_B: optimize.minimize,
            OptimizerType.DIFFERENTIAL_EVOLUTION: optimize.differential_evolution,
            OptimizerType.SIMULATED_ANNEALING: optimize.dual_annealing,
            OptimizerType.PARTICLE_SWARM: self._particle_swarm_optimizer
        }
    
    def _initialize_objectives(self) -> Dict[str, Callable]:
        """Initialize objective functions."""
        return {
            'mse': lambda model, market: np.mean((model - market) ** 2),
            'rmse': lambda model, market: np.sqrt(np.mean((model - market) ** 2)),
            'mae': lambda model, market: np.mean(np.abs(model - market)),
            'huber': self._huber_loss,
            'custom': None  # For user-defined objectives
        }
    
    def _initialize_constraints(self) -> Dict[str, Callable]:
        """Initialize constraint handlers."""
        return {
            'bounds': self._handle_bounds,
            'inequality': self._handle_inequality,
            'equality': self._handle_equality,
            'penalty': self._handle_penalty_method
        }
    
    def calibrate(self,
                  model: StochasticModel,
                  market_data: MarketData,
                  method: CalibrationMethod = CalibrationMethod.LEAST_SQUARES,
                  optimizer: OptimizerType = OptimizerType.LEVENBERG_MARQUARDT,
                  objective: str = 'mse',
                  constraints: Optional[Dict] = None,
                  initial_guess: Optional[Dict[str, float]] = None,
                  **kwargs) -> CalibrationResult:
        """
        Calibrate model to market data.
        
        Parameters
        ----------
        model : StochasticModel
            Model to calibrate
        market_data : MarketData
            Market data to calibrate to
        method : CalibrationMethod
            Calibration method
        optimizer : OptimizerType
            Optimization algorithm
        objective : str
            Objective function type
        constraints : dict, optional
            Constraints on parameters
        initial_guess : dict, optional
            Initial parameter guess
        **kwargs : dict
            Additional optimization parameters
            
        Returns
        -------
        CalibrationResult
            Calibration results
        """
        import time
        
        start_time = time.time()
        
        # Prepare calibration
        calibration_setup = self._prepare_calibration(
            model, market_data, method, objective, constraints, initial_guess
        )
        
        # Run optimization
        optimization_result = self._run_optimization(
            calibration_setup, optimizer, **kwargs
        )
        
        # Process results
        result = self._process_results(
            optimization_result, model, market_data, start_time
        )
        
        return result
    
    def _prepare_calibration(self,
                            model: StochasticModel,
                            market_data: MarketData,
                            method: CalibrationMethod,
                            objective: str,
                            constraints: Optional[Dict],
                            initial_guess: Optional[Dict]) -> Dict[str, Any]:
        """Prepare everything for calibration."""
        # Get model parameters
        param_names = model.parameter_names
        param_bounds = model.parameter_bounds
        
        # Set initial guess
        if initial_guess is None:
            initial_guess = model.default_parameters
        else:
            # Validate and complete initial guess
            initial_guess = self._validate_initial_guess(initial_guess, param_names, model)
        
        # Prepare constraints
        constraint_setup = self._prepare_constraints(constraints, param_bounds)
        
        # Prepare objective function
        objective_func = self._prepare_objective(
            model, market_data, method, objective
        )
        
        return {
            'param_names': param_names,
            'initial_guess': initial_guess,
            'constraints': constraint_setup,
            'objective_func': objective_func,
            'model': model,
            'market_data': market_data
        }
    
    def _run_optimization(self,
                         setup: Dict[str, Any],
                         optimizer_type: OptimizerType,
                         **kwargs) -> OptimizationResult:
        """Run the optimization."""
        # Extract setup
        param_names = setup['param_names']
        x0 = np.array([setup['initial_guess'][name] for name in param_names])
        objective_func = setup['objective_func']
        constraints = setup['constraints']
        
        # Get optimizer
        optimizer = self._optimizers[optimizer_type]
        
        # Prepare optimizer arguments
        opt_args = self._prepare_optimizer_args(
            optimizer_type, objective_func, x0, constraints, **kwargs
        )
        
        # Run optimization
        if optimizer_type == OptimizerType.LEVENBERG_MARQUARDT:
            # least_squares has different signature
            result = optimizer(objective_func, x0, **opt_args)
            # Convert to standard format
            opt_result = self._convert_least_squares_result(result)
        else:
            result = optimizer(**opt_args)
            opt_result = self._convert_minimize_result(result)
        
        return opt_result
    
    def _process_results(self,
                        opt_result: OptimizationResult,
                        model: StochasticModel,
                        market_data: MarketData,
                        start_time: float) -> CalibrationResult:
        """Process optimization results into CalibrationResult."""
        import time
        
        # Update model with calibrated parameters
        calibrated_params = dict(zip(model.parameter_names, opt_result.x))
        model.update_parameters(calibrated_params)
        
        # Calculate model prices with calibrated parameters
        model_prices = model.calculate(market_data)
        market_prices = market_data.prices
        
        # Calculate residuals
        residuals = model_prices - market_prices
        
        # Calculate confidence intervals if possible
        confidence_intervals = None
        if opt_result.jac is not None:
            confidence_intervals = self._calculate_confidence_intervals(
                opt_result, model.parameter_names
            )
        
        return CalibrationResult(
            success=opt_result.success,
            parameters=calibrated_params,
            initial_guess=model.default_parameters,
            objective_value=opt_result.fun,
            iterations=opt_result.nit,
            convergence_message=opt_result.message,
            calibration_time=time.time() - start_time,
            residuals=residuals,
            jacobian=opt_result.jac,
            hessian=opt_result.hess,
            confidence_intervals=confidence_intervals,
            market_data=market_data,
            model_prices=model_prices,
            market_prices=market_prices
        )
    
    def calibrate_with_uncertainty(self,
                                  model: StochasticModel,
                                  market_data: MarketData,
                                  n_bootstraps: int = 100,
                                  **kwargs) -> Dict[str, Any]:
        """
        Calibrate with uncertainty quantification using bootstrapping.
        
        Parameters
        ----------
        model : StochasticModel
            Model to calibrate
        market_data : MarketData
            Market data
        n_bootstraps : int
            Number of bootstrap samples
        **kwargs : dict
            Calibration parameters
            
        Returns
        -------
        Dict[str, Any]
            Calibration results with uncertainty
        """
        import concurrent.futures
        
        # Original calibration
        original_result = self.calibrate(model, market_data, **kwargs)
        
        # Bootstrap samples
        bootstrap_results = []
        n_data_points = len(market_data)
        
        def bootstrap_calibration(seed):
            np.random.seed(seed)
            # Resample with replacement
            indices = np.random.choice(n_data_points, size=n_data_points, replace=True)
            bootstrap_data = market_data.resample(indices)
            
            # Calibrate on bootstrap sample
            result = self.calibrate(
                model.copy(),
                bootstrap_data,
                **kwargs
            )
            return result.parameters
        
        # Parallel bootstrap
        with concurrent.futures.ProcessPoolExecutor() as executor:
            seeds = range(n_bootstraps)
            bootstrap_params = list(executor.map(bootstrap_calibration, seeds))
        
        # Calculate statistics
        param_stats = {}
        for param_name in model.parameter_names:
            param_values = [params[param_name] for params in bootstrap_params]
            param_stats[param_name] = {
                'mean': np.mean(param_values),
                'std': np.std(param_values),
                '2.5%': np.percentile(param_values, 2.5),
                '97.5%': np.percentile(param_values, 97.5),
                'bootstrap_values': param_values
            }
        
        return {
            'original_calibration': original_result,
            'bootstrap_statistics': param_stats,
            'n_bootstraps': n_bootstraps
        }
    
    def calibrate_multiple_models(self,
                                 models: List[StochasticModel],
                                 market_data: MarketData,
                                 **kwargs) -> Dict[str, CalibrationResult]:
        """
        Calibrate multiple models and compare results.
        
        Parameters
        ----------
        models : List[StochasticModel]
            Models to calibrate
        market_data : MarketData
            Market data
        **kwargs : dict
            Calibration parameters
            
        Returns
        -------
        Dict[str, CalibrationResult]
            Calibration results for each model
        """
        results = {}
        
        for model in models:
            model_name = model.__class__.__name__
            try:
                result = self.calibrate(model, market_data, **kwargs)
                results[model_name] = result
            except Exception as e:
                results[model_name] = CalibrationResult(
                    success=False,
                    parameters={},
                    initial_guess=model.default_parameters,
                    objective_value=np.inf,
                    iterations=0,
                    convergence_message=str(e),
                    calibration_time=0.0
                )
        
        return results
    
    def _calculate_confidence_intervals(self,
                                       result: OptimizationResult,
                                       param_names: List[str]) -> Dict[str, Tuple[float, float]]:
        """Calculate confidence intervals from Jacobian."""
        # Using asymptotic normality
        alpha = 0.05  # 95% confidence
        n = len(result.residuals) if result.residuals is not None else 1
        p = len(param_names)
        
        # Residual variance
        if result.residuals is not None:
            sigma2 = np.sum(result.residuals**2) / (n - p)
        else:
            sigma2 = result.fun / (n - p)
        
        # Covariance matrix
        if result.jac is not None:
            try:
                cov_matrix = sigma2 * np.linalg.inv(result.jac.T @ result.jac)
                std_errors = np.sqrt(np.diag(cov_matrix))
            except np.linalg.LinAlgError:
                return None
        else:
            return None
        
        # Confidence intervals
        from scipy import stats
        t_value = stats.t.ppf(1 - alpha/2, n - p)
        
        intervals = {}
        for i, name in enumerate(param_names):
            estimate = result.x[i]
            se = std_errors[i]
            lower = estimate - t_value * se
            upper = estimate + t_value * se
            intervals[name] = (lower, upper)
        
        return intervals
```

